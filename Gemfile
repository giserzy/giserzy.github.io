source "https://rubygems.org"

# 使用 GitHub Pages gem（包含所有兼容的插件）
gem "github-pages", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

# Web 服务器
gem "webrick", "~> 1.8"

# Windows 平台支持
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

